name: Flutter Build APK

on:
  push:
    branches: [ "main", "master" ]
  pull_request:
    branches: [ "main", "master" ]

jobs:
  build:
    runs-on: ubuntu-latest

    # SCRIPT DI BAWAH INI AKAN MEMAKSA GITHUB MASUK KE FOLDER PROYEK ANDA
    defaults:
      run:
        working-directory: audit_stock_opname_v1_0 # <--- GANTI INI dengan nama folder proyek Anda yang ada di GitHub

    steps:
    - uses: actions/checkout@v4

    - name: Setup Java JDK
      uses: actions/setup-java@v4
      with:
        distribution: 'temurin'
        java-version: '17'

    - name: Setup Flutter
      uses: subosito/flutter-action@v2
      with:
        channel: 'stable'

    - name: Get dependencies
      run: flutter pub get

    - name: Build APK
      run: flutter build apk --debug --no-pub

    - name: Upload APK Artifact
      uses: actions/upload-artifact@v4
      with:
        name: app-debug-apk
        # Path di bawah ini disesuaikan karena menggunakan working-directory di atas
        path: ${{ github.workspace }}/audit_stock_opname_v1_0/build/app/outputs/flutter-apk/*.apk # <--- GANTI JUGA teks folder di sini
